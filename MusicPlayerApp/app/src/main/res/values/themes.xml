<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MusicPlayer" parent="android:Theme.Material.NoActionBar" />

    <!-- Раніше splash-екран не налаштовувався взагалі, тому Android 12+ показував
         власний дефолтний вигляд (звідси "стандартна/некоректна іконка при старті").
         Теперь явно задаємо темний фон і власну іконку вінілу, з переходом на
         основну тему застосунку одразу після завершення splash. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MusicPlayer</item>
    </style>
</resources>
